rules_version = '2';

// Optional — rxusage doesn't store files today.
// New project: paste this whole file into Firebase console → Storage → Rules.
// Shared project: copy only the "rxusage" match block into the existing `match /b/{bucket}/o { ... }`.
service firebase.storage {
  match /b/{bucket}/o {

    // ---- rxusage: each user reads/writes only rxusage/{uid}/** ----
    match /rxusage/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // ---- end rxusage ----

  }
}
