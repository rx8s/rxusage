rules_version = '2';

// New Firebase project used only by rxusage: paste this whole file into
//   Firebase console → Firestore Database → Rules, then Publish.
// Project shared with other apps: copy only the "rxusage" match block below into the existing
//   `match /databases/{database}/documents { ... }` section. Don't replace the other rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- rxusage: each user reads/writes only rxusage/{uid}/** ----
    match /rxusage/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Optional: also limit to your own Google account(s) — replace the email and use this line instead:
      // allow read, write: if request.auth != null && request.auth.uid == uid
      //   && request.auth.token.email in ['you@gmail.com'];
    }
    // ---- end rxusage ----

  }
}
