# Copy to .dev.vars for `npm run preview` (Cloudflare Pages Functions at /api/usage and /api/limits).
# In production, add these in Cloudflare Pages → Settings → Variables and Secrets (as encrypted secrets).
FIREBASE_PROJECT_ID=rxanymore
# Only this verified sign-in email may read API usage.
ALLOWED_EMAIL=
# Anthropic Console → Settings → Admin keys (sk-ant-admin...). Leave empty to skip.
ANTHROPIC_ADMIN_KEY=
# OpenAI Platform → Settings → Organization → Admin keys. Leave empty to skip.
OPENAI_ADMIN_KEY=
# SHA-256 (hex) of the Mac collector's token, printed by collector/install.sh. Not a secret.
LIMITS_INGEST_TOKEN_SHA256=
